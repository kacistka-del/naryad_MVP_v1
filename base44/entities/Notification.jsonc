{
  "name": "Notification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "relatedOrderId": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "type",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}