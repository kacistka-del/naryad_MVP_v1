# --- Server ---
PORT=8080
NODE_ENV=production

# Публичный адрес фронтенда (для OAuth-редиректов и писем)
APP_BASE_URL=http://localhost:5173
# Публичный адрес API (для формирования ссылок на файлы)
PUBLIC_API_URL=http://localhost:8080
# Разрешённые origin через запятую. Пусто = отражать origin запроса.
CORS_ORIGIN=

# --- Database ---
DATABASE_URL=postgres://naryad:naryad@localhost:5432/naryad

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
# Требовать подтверждение email кодом из письма (true/false)
REQUIRE_EMAIL_VERIFICATION=true

# --- Первый администратор (используется npm run seed) ---
ADMIN_EMAIL=admin@naryad.local
ADMIN_PASSWORD=change_me

# --- Почта (если не задано, коды печатаются в лог сервера) ---
SMTP_URL=
MAIL_FROM="NARYAD <no-reply@naryad.local>"

# --- Загрузка файлов ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- LLM для structureOrder (необязательно) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
